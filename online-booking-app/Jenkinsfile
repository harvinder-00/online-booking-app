pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        IMAGE_NAME = "online-booking-app"
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
        CONTAINER_NAME = "online-booking-app"
        APP_PORT = "3000"
        APP_DIR = "online-booking-app"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        echo "Node version:"
                        node -v
                        echo "Running test suite..."
                        npm test
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:3000 \
                        --restart unless-stopped \
                        ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Smoke Test / Monitoring Check') {
            steps {
                sh '''
                    sleep 5
                    echo "Checking /health endpoint..."
                    curl -f http://host.docker.internal:${APP_PORT}/health
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded: ${IMAGE_NAME}:${IMAGE_TAG} deployed and healthy."
        }
        failure {
            echo "Pipeline failed - check the stage logs above."
        }
        always {
            sh "docker image prune -f || true"
        }
    }
}
